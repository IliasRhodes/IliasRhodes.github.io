---
// src/pages/photography.astro — photos come from tools/sync-photos.mjs; never edit src/data/photos.json or public/photography/ by hand.
import BaseLayout from '../layouts/BaseLayout.astro';
import photos from '../data/photos.json';
---
<BaseLayout title="Photography" description="Photographs by Ilias Mandalos.">
  <h1>Photography</h1>
  <p class="intro">Where I practise looking.</p>
  <ul class="photos" data-photos>
    {photos.map((p, i) => (
      <li style={`--r: ${(p.width / p.height).toFixed(4)}`}>
        <a href={p.full} data-index={i}>
          <img src={p.src} alt={p.alt} width={p.width} height={p.height} loading={i < 4 ? 'eager' : 'lazy'} decoding="async" />
        </a>
      </li>
    ))}
  </ul>
  <dialog class="viewer" aria-label="Photo viewer" data-viewer>
    <img alt="" data-viewer-img />
    <div class="bar">
      <button type="button" data-prev>Previous</button>
      <span class="mono" data-count aria-live="polite"></span>
      <button type="button" data-next>Next</button>
      <button type="button" data-close>Close</button>
    </div>
  </dialog>
</BaseLayout>
<script>
  import { initViewer } from '../scripts/viewer.mjs';
  initViewer(document.querySelector('[data-photos]'), document.querySelector('[data-viewer]'));
</script>
<style>
  .intro { max-width: var(--measure); margin: 0 0 var(--space-4); }
  /* Justified rows: each photo grows in proportion to its width/height, so every photo in a row shares one height
     and nothing is cropped. The ::after soaks up the last row so it never stretches to giant size. */
  .photos { list-style: none; margin: 0; padding: 0; display: flex; flex-wrap: wrap; gap: var(--space-2); }
  .photos::after { content: ''; flex-grow: 1000000; }
  .photos li { flex: calc(var(--r) * 100) 1 calc(var(--r) * 15rem); min-width: 0; }
  .photos a { display: block; }
  .photos img { display: block; width: 100%; height: auto; background: var(--foil-2); }
  @media (max-width: 36rem) { .photos li { flex-basis: 100%; } }

  .viewer { width: 100vw; height: 100dvh; max-width: none; max-height: none; margin: 0; padding: var(--gutter);
    border: 0; background: var(--bg); color: var(--ink); }
  .viewer[open] { display: grid; grid-template-rows: 1fr auto; gap: var(--space-2); }
  .viewer img { min-height: 0; width: 100%; height: 100%; object-fit: contain; }
  .bar { display: flex; flex-wrap: wrap; justify-content: center; align-items: center; gap: var(--space-2); }
  .bar button { font: inherit; font-size: var(--text-small); color: var(--ink); background: none; border: 2px solid var(--green);
    padding: 0.5rem 1rem; min-height: 44px; cursor: pointer; }
  .bar [data-close] { margin-left: var(--space-3); }
</style>
