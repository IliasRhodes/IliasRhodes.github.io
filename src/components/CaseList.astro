---
// src/components/CaseList.astro
import type { CollectionEntry } from 'astro:content';
interface Props { cases: CollectionEntry<'work'>[] }
const { cases } = Astro.props;
---
<ol class="cases">
  {cases.map((c, i) => (
    <li>
      <span class="mono n" aria-hidden="true">{String(i + 1).padStart(2, '0')}</span>
      <h3><a href={`/work/${c.id}/`}>{c.data.title}</a></h3>
      <span class="mono tag">{c.data.tag}</span>
      <p>{c.data.summary}</p>
    </li>
  ))}
</ol>
<style>
  .cases { list-style: none; margin: 0; padding: 0; }
  li { display: grid; grid-template-columns: 2.5rem minmax(0, 1fr) auto; gap: 0.25rem 1rem; align-items: baseline; padding: 1rem 0; border-top: 1px solid var(--ink); }
  li:last-child { border-bottom: 1px solid var(--ink); }
  h3 { margin: 0; font-size: 1.2rem; }
  .n { color: var(--grey); }
  .tag { color: var(--green); }
  p { grid-column: 2 / -1; margin: 0; color: var(--grey); font-size: var(--text-small); }
  @media (max-width: 40rem) {
    li { grid-template-columns: 2rem minmax(0, 1fr); }
    .tag { grid-column: 2; }
  }
</style>
